<?xml version="1.0" encoding="utf-8"?>
<!--
  Tập tin cấu hình ứng dụng Web (Chương 7 - IV. Tập tin Web.config)
-->
<configuration>
  <appSettings>
    <!-- Bước 3 (theo tài liệu): chuỗi kết nối CSDL đặt trong appSettings -->
    <add key="ConnectionString" value="Data Source=localhost;Initial Catalog=QLLinhKien;Integrated Security=True" />
    <!-- Thư mục lưu hình sản phẩm -->
    <add key="ThuMucHinh" value="~/Images/SanPham/" />
    <!-- Tắt chế độ Unobtrusive để các Validation Control chạy không cần jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="4096" />
    <!-- Áp dụng Theme LinhKien cho toàn bộ website (Chương 7 - Bài 2 - Themes) -->
    <pages theme="LinhKien" maintainScrollPositionOnPostBack="true" />
    <!-- Session hết hạn sau 30 phút -->
    <sessionState mode="InProc" timeout="30" />
    <globalization culture="vi-VN" uiCulture="vi-VN" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="Off" />
  </system.web>
  <!-- Cho phép IIS / IIS Express phục vụ file font .woff2 đóng gói trong Theme -->
  <system.webServer>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
